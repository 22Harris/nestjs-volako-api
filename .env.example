# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Authentification — OBLIGATOIRE au démarrage (min. 32 caractères aléatoires)
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# CORS — URL du frontend Angular
FRONTEND_URL=http://localhost:4200

# Environnement d'exécution (development | production)
NODE_ENV=development

# Port d'écoute de l'API (défaut : 3000)
PORT=3000
