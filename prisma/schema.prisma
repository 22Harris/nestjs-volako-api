generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Operation {
  id        Int           @id @default(autoincrement())
  type      String
  date      DateTime
  label     String
  amount    Int           @default(0)

  entries   JournalEntry[]
}

model Account {
  id     Int    @id @default(autoincrement())
  code   String @unique
  name   String
  class  Int

  journalLines JournalLine[]
}

model JournalEntry {
  id          Int        @id @default(autoincrement())
  date        DateTime
  label       String
  operationId Int?
  operation   Operation? @relation(fields: [operationId], references: [id])

  lines JournalLine[]
}

model JournalLine {
  id        Int    @id @default(autoincrement())
  debit     Int
  credit    Int
  accountId Int
  entryId   Int

  account Account      @relation(fields: [accountId], references: [id])
  entry   JournalEntry @relation(fields: [entryId], references: [id])
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
}

model Evenement {
  id           Int      @id @default(autoincrement())
  titre        String
  categorie    String
  montant      Int
  dateEcheance DateTime
  recurrence   String
  statut       String
  notes        String?
}

model Objectif {
  id            Int      @id @default(autoincrement())
  nom           String
  description   String?
  categorie     String
  montantCible  Int
  montantActuel Int      @default(0)
  dateDebut     DateTime
  dateEcheance  DateTime
  couleur       String
  icone         String
  statut        String
}

model Budget {
  id       Int           @id @default(autoincrement())
  exercice Int
  mois     Int
  lignes   BudgetLigne[]
}

model BudgetLigne {
  id           Int    @id @default(autoincrement())
  categorie    String
  libelle      String
  montantPrevu Int
  type         String
  budgetId     Int
  budget       Budget @relation(fields: [budgetId], references: [id])
}
